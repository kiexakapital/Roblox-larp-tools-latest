{
  "manifest_version": 3,
  "name": "Roblox LARP Tools",
  "version": "2.0.0",
  "description": "Roblox deneyiminizi görsel araçlar ve eklentilerle kişiselleştirin.",
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "debugger",
    "windows",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://discord.com/*",
    "*://*.discord.com/*",
    "*://*.roblox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Roblox LARP Tools"
  },
  "content_scripts": [
    {
      "matches": ["*://*.roblox.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}